autoload -Uz compinit && compinit -C

# history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
bindkey -e
zstyle ':completion:*' menu select
# 補完で大文字小文字を区別しない
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# theme
source ~/.dotfiles/config/zsh/ys-orange.zsh-theme

# User configuration
export LANG=ja_JP.UTF-8
source ~/.dotfiles/config/zsh/alias.sh
source ~/.dotfiles/config/zsh/export.sh

# nix (home-manager)
[ -f "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ] && . "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
[ -d "$HOME/.nix-profile/bin" ] && export PATH="$HOME/.nix-profile/bin:$PATH"

# tmux auto-start
if [[ -z "$TMUX" && -o interactive ]] && command -v tmux &>/dev/null; then
  export COLORFGBG="15;0"
  while read -t 0.1 -k 1 2>/dev/null; do :; done

  # Interactive SSH logins share the existing primary session.
  if [[ -n "$SSH_CONNECTION" ]] && tmux has-session -t 0 2>/dev/null; then
    exec tmux attach-session -t 0
  fi

  tmux new-session && exit
fi

# mise
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/naoya/Documents/tools/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/naoya/Documents/tools/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/naoya/Documents/tools/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/naoya/Documents/tools/google-cloud-sdk/completion.zsh.inc'; fi

